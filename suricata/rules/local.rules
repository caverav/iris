# Tulip A/D seed ruleset.
#
# Conventions:
#   * sid range 9000000-9000999 is reserved for seed rules.
#   * Every rule carries `metadata: tag <short_name>;` so Tulip surfaces a
#     `rule:<short_name>` filter tag.
#   * `drop` is used only on high-confidence patterns (RCE, traversal,
#     flag egress). Lower-confidence patterns use `alert` so you can
#     review before deciding to block.
#
# Tune these for your CTF before relying on them in IPS mode.

# --- Path traversal ---------------------------------------------------------
drop tcp any any -> $HOME_NET any ( \
  msg:"TULIP path traversal (../)"; \
  flow:to_server,established; content:"../"; \
  metadata: tag path_traversal; \
  classtype:web-application-attack; \
  sid:9000001; rev:1;)

drop tcp any any -> $HOME_NET any ( \
  msg:"TULIP path traversal (encoded %2e%2e)"; \
  flow:to_server,established; content:"%2e%2e"; nocase; \
  metadata: tag path_traversal; \
  classtype:web-application-attack; \
  sid:9000002; rev:1;)

drop tcp any any -> $HOME_NET any ( \
  msg:"TULIP path traversal (/etc/passwd)"; \
  flow:to_server,established; content:"/etc/passwd"; nocase; \
  metadata: tag path_traversal; \
  classtype:web-application-attack; \
  sid:9000003; rev:1;)

# --- RCE sentinels ----------------------------------------------------------
drop tcp any any -> $HOME_NET any ( \
  msg:"TULIP RCE reverse shell (bash -i)"; \
  flow:to_server,established; content:"bash -i"; \
  metadata: tag rce; \
  classtype:attempted-admin; \
  sid:9000010; rev:1;)

drop tcp any any -> $HOME_NET any ( \
  msg:"TULIP RCE (/bin/sh in request)"; \
  flow:to_server,established; content:"/bin/sh"; \
  metadata: tag rce; \
  classtype:attempted-admin; \
  sid:9000011; rev:1;)

alert tcp any any -> $HOME_NET any ( \
  msg:"TULIP RCE sentinel (;id;)"; \
  flow:to_server,established; content:";id;"; \
  metadata: tag rce; \
  classtype:attempted-admin; \
  sid:9000012; rev:1;)

# --- PHP wrapper / LFI ------------------------------------------------------
alert tcp any any -> $HOME_NET any ( \
  msg:"TULIP PHP wrapper (php://filter)"; \
  flow:to_server,established; content:"php://"; nocase; \
  metadata: tag php_wrapper; \
  classtype:web-application-attack; \
  sid:9000020; rev:1;)

# --- SQL injection (classic tokens) -----------------------------------------
alert tcp any any -> $HOME_NET any ( \
  msg:"TULIP SQLi UNION SELECT"; \
  flow:to_server,established; content:"union"; nocase; content:"select"; nocase; distance:0; within:30; \
  metadata: tag sqli; \
  classtype:web-application-attack; \
  sid:9000030; rev:1;)

alert tcp any any -> $HOME_NET any ( \
  msg:"TULIP SQLi OR 1=1"; \
  flow:to_server,established; pcre:"/(or|OR)\s*(1\s*=\s*1|'[a-z0-9]'\s*=\s*'[a-z0-9]')/"; \
  metadata: tag sqli; \
  classtype:web-application-attack; \
  sid:9000031; rev:1;)

# --- SSRF to cloud metadata -------------------------------------------------
alert tcp any any -> any any ( \
  msg:"TULIP SSRF to 169.254.169.254"; \
  flow:to_server,established; content:"169.254.169.254"; \
  metadata: tag ssrf_metadata; \
  classtype:web-application-attack; \
  sid:9000040; rev:1;)

# --- Flag exfiltration (egress) ---------------------------------------------
# Replace the content below or add a pcre for your CTF's flag format.
# .env.example FLAG_REGEX is "[A-Z0-9]{31}=" by default.
drop tcp $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"TULIP flag exfiltration (default FAUST-like format)"; \
  flow:established,to_server; pcre:"/[A-Z0-9]{31}=/"; \
  metadata: tag flag_exfil; \
  classtype:policy-violation; \
  sid:9000050; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any ( \
  msg:"TULIP flag exfiltration to client (response body)"; \
  flow:established,to_client; pcre:"/[A-Z0-9]{31}=/"; \
  metadata: tag flag_exfil; \
  classtype:policy-violation; \
  sid:9000051; rev:1;)

# --- Reconnaissance ---------------------------------------------------------
alert tcp any any -> $HOME_NET any ( \
  msg:"TULIP recon (/.git/ access)"; \
  flow:to_server,established; content:"/.git/"; nocase; \
  metadata: tag recon; \
  classtype:web-application-attack; \
  sid:9000060; rev:1;)

alert tcp any any -> $HOME_NET any ( \
  msg:"TULIP recon (/admin/ probe)"; \
  flow:to_server,established; content:"/admin"; http_uri; \
  metadata: tag recon; \
  classtype:web-application-activity; \
  sid:9000061; rev:1;)
