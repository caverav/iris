@dataclass
class WizardState:
    env: dict[str, str] = field(default_factory=dict)
    services: list[Service] = field(default_factory=list)
    vm_ip_1: str = "10.60.2.1"
    mode: str = "all-in-one-ids"
    skip_services: bool = False

    # Was the user running the wizard on an existing install?
    had_existing_env: bool = False


def screen_welcome(state: WizardState, existing: dict[str, str]) -> None:
    banner()
    print(dim("  Press Enter at any prompt to accept the highlighted default."))
    print(dim("  You can re-run this wizard anytime - existing values become the defaults.\n"))
    if existing:
        info(f"Detected existing .env with {len(existing)} keys. Loaded as defaults.")
        state.had_existing_env = True


def screen_mode(state: WizardState) -> None:
    section("Deployment mode")
    print("  Iris supports three deployment shapes. Pick the one that matches your CTF:")

    # Derive a default from the existing COMPOSE_PROFILES if present.
    current = state.env.get("COMPOSE_PROFILES", "")
    default_idx = 1
    for i, (_, profiles, _) in enumerate(DEPLOYMENT_PRESETS, 1):
        if profiles == current:
            default_idx = i
            break

    choice = ask_choice(
        "",
        [(k, f"{d}\n        {dim(f'COMPOSE_PROFILES={p}')}") for k, p, d in DEPLOYMENT_PRESETS],
        default=default_idx,
    )
    state.mode = choice
    profiles = dict((k, p) for k, p, _ in DEPLOYMENT_PRESETS)[choice]
    state.env["COMPOSE_PROFILES"] = profiles

    # Split-vulnbox mode doesn't run the Iris stack here - skip the flow list /
    # service / flag-validator screens.
    state.skip_services = choice == "split-vulnbox"


def screen_traffic(state: WizardState) -> None:
    if state.skip_services:
        return
    section("Traffic source")
    print("  Where do pcaps arrive from?")

    current = state.env
    has_rsync_default = not current.get("PCAP_OVER_IP") and not current.get("DUMP_PCAPS")
    has_pcap_over_ip = bool(current.get("PCAP_OVER_IP"))
    has_dump = bool(current.get("DUMP_PCAPS"))
    default = 1 if has_rsync_default else (2 if has_pcap_over_ip else (3 if has_dump else 1))

    choice = ask_choice(
        "",
        [
            ("rsync", "rsync into a shared directory (default / README recipe)"),
            ("pcap-over-ip", "PCAP-over-IP stream from a remote tcpdump server"),
            ("dump", "Iris captures pcaps locally (DUMP_PCAPS)"),
        ],
        default=default,
    )

    # Demo pcaps live at services/test_pcap and are useful for first-time
    # demos but pointless on a real CTF deployment. Offer a clean default.
    current_dir = state.env.get("TRAFFIC_DIR_HOST", "")
    has_demos_default = (current_dir == "" or "test_pcap" in current_dir)
    include_demos = ask_choice(
        "Include the demo pcaps shipped at services/test_pcap?",
        [
            ("yes", "yes - handy for kicking the tyres on first install"),
            ("no",  "no  - create an empty ./traffic for live captures only"),
        ],
        default=1 if has_demos_default else 2,
    )
    default_traffic_dir = (
        "./services/test_pcap" if include_demos == "yes" else "./traffic"
    )
    state.env["TRAFFIC_DIR_HOST"] = ask(
        "Host path to the pcap directory:",
        default=state.env.get("TRAFFIC_DIR_HOST", default_traffic_dir),
        required=True,
    )
    state.env["TRAFFIC_DIR_DOCKER"] = ask(
        "In-container path:",
        default=state.env.get("TRAFFIC_DIR_DOCKER", "/traffic"),
        required=True,
    )

    if choice == "pcap-over-ip":
        state.env["PCAP_OVER_IP"] = ask(
            "PCAP-over-IP endpoint (host:port, comma-separated for multiple):",
            default=state.env.get("PCAP_OVER_IP", "host.docker.internal:1337"),
            required=True,
        )
        state.env["DUMP_PCAPS"] = ""
    elif choice == "dump":
        state.env["DUMP_PCAPS"] = ask(
            "Directory Iris should dump pcaps into:",
            default=state.env.get("DUMP_PCAPS", "/traffic"),
            required=True,
        )
        state.env["DUMP_PCAPS_INTERVAL"] = ask(
            "Rotation interval (e.g. 1m, 30s):",
            default=state.env.get("DUMP_PCAPS_INTERVAL", "1m"),
            required=True,
        )
        state.env["DUMP_PCAPS_FILENAME"] = ask(
            "Filename template (Go time format):",
            default=state.env.get("DUMP_PCAPS_FILENAME", "2006-01-02_15-04-05.pcap"),
            required=True,
        )
        state.env["PCAP_OVER_IP"] = ""
    else:
        state.env["PCAP_OVER_IP"] = ""
        state.env["DUMP_PCAPS"] = ""

    bpf = ask(
        "BPF filter (optional, e.g. 'port 8080'):",
        default=state.env.get("BPF", ""),
        allow_empty=True,
    )
    state.env["BPF"] = bpf


def _default_tick_start() -> str:
    now = datetime.now(timezone.utc).replace(microsecond=0)
    return now.strftime("%Y-%m-%dT%H:%M:%SZ")


def screen_game(state: WizardState) -> None:
    section("Game parameters")
    cur_start = state.env.get("TICK_START", _default_tick_start())
    state.env["TICK_START"] = ask(
        "CTF start time (ISO-8601, e.g. 2025-05-18T13:00:00Z):",
        default=cur_start,
        validator=v_iso_datetime,
        required=True,
    )

    cur_len = state.env.get("TICK_LENGTH", "180000")
    default_idx = 1
    for i, (v, _) in enumerate(TICK_LENGTH_PRESETS, 1):
        if v == cur_len:
            default_idx = i
            break
    tick_choice = ask_choice("Tick length:",
                             [(v, label) for v, label in TICK_LENGTH_PRESETS],
                             default=default_idx)
    if tick_choice == "custom":
        state.env["TICK_LENGTH"] = ask(
            "Tick length (milliseconds):",
            default=cur_len,
            validator=v_positive_int,
            required=True,
        )
    else:
        state.env["TICK_LENGTH"] = tick_choice

    # Flag regex presets
    cur_regex = state.env.get("FLAG_REGEX", "[A-Z0-9]{31}=")
    default_idx = len(FLAG_PRESETS)  # default to "custom" if nothing matches
    for i, (_, pattern, _) in enumerate(FLAG_PRESETS, 1):
        if pattern == cur_regex:
            default_idx = i
            break
    flag_choice = ask_choice("Flag regex:",
                             [(k, f"{label}  {dim(pat or '(type your own)')}")
                              for k, pat, label in FLAG_PRESETS],
                             default=default_idx)
    if flag_choice == "custom":
        state.env["FLAG_REGEX"] = ask(
            "Flag regex:",
            default=cur_regex,
            validator=v_regex,
            required=True,
        )
    else:
        state.env["FLAG_REGEX"] = dict((k, p) for k, p, _ in FLAG_PRESETS)[flag_choice]

    state.env["VM_IP"] = ask(
        "Your team's vulnbox IP:",
        default=state.env.get("VM_IP", "10.10.3.1"),
        validator=v_ip,
        required=True,
    )
    state.env["TEAM_ID"] = ask(
        "Your team number / ID:",
        default=state.env.get("TEAM_ID", "3"),
        required=True,
    )


def _parse_existing_services(path: Path) -> tuple[list[Service], str]:
    """Parse the current configurations.py. Returns (services, vm_ip_1)."""
    services: list[Service] = []
    vm_ip_1 = "10.60.2.1"
    if not path.is_file():
        return services, vm_ip_1
    text = path.read_text()

    m = re.search(r"vm_ip_1\s*=\s*[\"']([^\"']+)[\"']", text)
    if m:
        vm_ip_1 = m.group(1)

    # Try the {"ip": .., "port": .., "name": ..} shape first.
    for mm in re.finditer(
        r"\{\s*['\"]ip['\"]:\s*['\"]([^'\"]+)['\"]\s*,\s*['\"]port['\"]:\s*(-?\d+)\s*,\s*['\"]name['\"]:\s*['\"]([^'\"]+)['\"]\s*\}",
        text,
    ):
        ip, port, name = mm.group(1), int(mm.group(2)), mm.group(3)
        if name == "other":
            continue  # skip the fallback row, we re-add it on write
        services.append(Service(ip=ip, port=port, name=name))

    if services:
        return services, vm_ip_1

    # Fall back to parsing the heredoc-style `helper = '''...'''` block.
    m = re.search(r"helper\s*=\s*'''(.*?)'''", text, re.DOTALL)
    if m:
        for line in m.group(1).strip().splitlines():
            line = line.strip()
            if not line:
                continue
            parts = line.split(None, 1)
            if len(parts) != 2:
                continue
            addr, name = parts
            if ":" not in addr:
                continue
            ip, port = addr.rsplit(":", 1)
            try:
                services.append(Service(ip=ip, port=int(port), name=name))
            except ValueError:
                continue
    return services, vm_ip_1


def screen_services(state: WizardState, existing_services: list[Service], existing_vm_ip_1: str) -> None:
    if state.skip_services:
        return
    section("Services (the ones you defend)")
    print(dim("  These land in services/api/configurations.py and drive the service dropdown."))

    state.services = list(existing_services)
    state.vm_ip_1 = existing_vm_ip_1

    if state.services:
        info(f"{len(state.services)} service(s) already defined:")
        for i, s in enumerate(state.services, 1):
            print(f"    {dim(f'[{i}]')} {bold(s.name):<24} {s.ip}:{s.port}")
        if ask_bool("Keep these as-is?", default=True):
            pass
        else:
            state.services = []

    while True:
        if state.services:
            print()
            info(f"Current: {', '.join(f'{s.name}@{s.ip}:{s.port}' for s in state.services)}")
        if not ask_bool("Add a service?", default=not state.services):
            break
        name = ask("Service name (e.g. BIOMarkt):", required=True).strip()
        if not name:
            continue
        ip = ask("Service IP:", default=state.env.get("VM_IP", ""), validator=v_ip, required=True)
        port = int(ask("Service port:", validator=v_port, required=True))
        state.services.append(Service(ip=ip, port=port, name=name))

    state.vm_ip_1 = ask(
        "Fallback IP (used for the 'other' entry in the dropdown):",
        default=state.vm_ip_1,
        validator=v_ip,
        required=True,
    )


def screen_suricata(state: WizardState) -> None:
    section("Suricata")
    state.env["SURICATA_DIR_HOST"] = ask(
        "Directory to store Suricata rules/logs/etc (seeded on first run):",
        default=state.env.get("SURICATA_DIR_HOST", "./suricata-runtime"),
