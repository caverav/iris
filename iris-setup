@dataclass
class Service:
    ip: str
    port: int
    name: str


def render_configurations_py(services: list[Service], fallback_ip: str) -> str:
    lines: list[str] = []
    for s in services:
        lines.append(f"{s.ip}:{s.port} {s.name}")

    rendered_services = "\n".join(
        f'    {{"ip": {s.ip!r}, "port": {s.port}, "name": {s.name!r}}},' for s in services
    )

    out = _CONFIG_HEADER + "\n"
    out += f"vm_ip_1 = {fallback_ip!r}\n"
    out += "services = [\n"
    out += rendered_services + "\n"
    out += "]\n"
    out += "services += [{\"ip\": vm_ip_1, \"port\": -1, \"name\": \"other\"}]\n"
    return out


