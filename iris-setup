def _split_keys_dir(repo_root: Path) -> Path:
    # Note: `iris-setup` itself is a file (this script) at the repo root, so
    # the keypair lives under iris-keys/ rather than the more obvious
    # iris-setup/keys/ - otherwise mkdir trips on the file collision.
    return repo_root / "iris-keys"


def _ensure_split_keypair(repo_root: Path) -> tuple[Path, Path]:
    """Generate (or reuse) the analysis-box ed25519 keypair under iris-keys/."""
    import shutil
    keys_dir = _split_keys_dir(repo_root)
    keys_dir.mkdir(parents=True, exist_ok=True)
    priv = keys_dir / "id_ed25519"
    pub = keys_dir / "id_ed25519.pub"
    if priv.exists() and pub.exists():
        info(f"Reusing keypair at {priv}")
        return priv, pub
    if shutil.which("ssh-keygen") is None:
        err("ssh-keygen not on PATH; install OpenSSH client to generate keys.")
        raise SystemExit(2)
    import subprocess
    subprocess.run(
        [
            "ssh-keygen",
            "-t", "ed25519",
            "-f", str(priv),
            "-N", "",
            "-C", "iris-vulnbox-shipper",
        ],
        check=True,
    )
    priv.chmod(0o600)
    info(f"Generated {priv} (and .pub).")
    return priv, pub


def _detect_gamenet_ip() -> str | None:
    """Best-effort: find the IP on a wireguard / player / tun-style iface."""
    import subprocess
    try:
        out = subprocess.run(
            ["ip", "-4", "-br", "addr"], capture_output=True, text=True, check=False
        ).stdout
    except FileNotFoundError:
        return None
    for line in out.splitlines():
        parts = line.split()
        if len(parts) < 3:
            continue
        iface = parts[0]
        if not re.search(r"^(wg\d+|player|tun|game)", iface):
            continue
        addr = parts[2].split("/")[0]
        if addr and not addr.startswith("127."):
            return addr
    return None


