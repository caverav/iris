# ---------------------------------------------------------------------------
# Colour / IO helpers
# ---------------------------------------------------------------------------

_USE_COLOR = sys.stdout.isatty()


def _c(code: str, text: str) -> str:
    if not _USE_COLOR:
        return text
    return f"\x1b[{code}m{text}\x1b[0m"


def dim(s: str) -> str:      return _c("2", s)
def bold(s: str) -> str:     return _c("1", s)
def accent(s: str) -> str:   return _c("1;38;5;205", s)   # magenta/pink - iris
def cyan(s: str) -> str:     return _c("38;5;117", s)
def green(s: str) -> str:    return _c("38;5;114", s)
def yellow(s: str) -> str:   return _c("38;5;221", s)
def red(s: str) -> str:      return _c("38;5;203", s)


IRIS_ASCII = r"""
        \  |  /
         \ | /
          \|/            iris
           *          setup wizard
          /|\
         / | \
        /  |  \
           |
           |
"""


def banner() -> None:
    print(accent(IRIS_ASCII))


def section(title: str) -> None:
    print()
    print(accent("-- " + title + " " + "-" * max(0, 58 - len(title))))


def info(msg: str) -> None:
    print(cyan("> ") + msg)


def warn(msg: str) -> None:
    print(yellow("! ") + msg)


def err(msg: str) -> None:
    print(red("x ") + msg, file=sys.stderr)


# ---------------------------------------------------------------------------
# Prompts
# ---------------------------------------------------------------------------

def _fmt_default(default: str | None) -> str:
    if default is None or default == "":
        return dim(" [empty]")
    return dim(f" [{default}]")


def ask(
    prompt: str,
    default: str | None = None,
    validator=None,
    required: bool = False,
    allow_empty: bool = False,
) -> str:
    """Prompt for a single line. Enter accepts the default."""
    while True:
        raw = input(f"  {prompt}{_fmt_default(default)} ").strip()
        value = raw if raw else (default or "")
        if not value and not allow_empty and required:
            err("This value is required.")
            continue
        if validator:
            ok, msg = validator(value)
            if not ok:
                err(msg)
                continue
        return value


def ask_choice(prompt: str, choices: list[tuple[str, str]], default: int = 1) -> str:
    """Prompt with a numbered list. Returns the key of the chosen entry.

    choices is a list of (key, label).
    """
    print(f"  {prompt}")
    for i, (key, label) in enumerate(choices, 1):
        marker = accent(f"[{i}]") if i == default else dim(f"[{i}]")
        print(f"    {marker} {label}")
    while True:
        raw = input(f"  Choice{_fmt_default(str(default))} ").strip() or str(default)
        if raw.isdigit() and 1 <= int(raw) <= len(choices):
            return choices[int(raw) - 1][0]
        if raw in [k for k, _ in choices]:
            return raw
        err(f"Pick a number 1..{len(choices)}.")


def ask_bool(prompt: str, default: bool) -> bool:
    suffix = "Y/n" if default else "y/N"
    while True:
        raw = input(f"  {prompt} [{suffix}] ").strip().lower()
        if not raw:
            return default
        if raw in ("y", "yes", "1", "true"):
            return True
        if raw in ("n", "no", "0", "false"):
            return False
        err("Please answer yes or no.")


# ---------------------------------------------------------------------------
# Validators
# ---------------------------------------------------------------------------

_IP_RE = re.compile(r"^(?:\d{1,3}\.){3}\d{1,3}$|^[0-9a-fA-F:]+$")


def v_ip(value: str) -> tuple[bool, str]:
    if not value:
        return False, "IP is required."
    if not _IP_RE.match(value):
        return False, "Not a valid IPv4/IPv6 literal."
    return True, ""


def v_port(value: str) -> tuple[bool, str]:
    if not value.isdigit() or not (1 <= int(value) <= 65535):
        return False, "Port must be an integer 1..65535."
    return True, ""


def v_regex(value: str) -> tuple[bool, str]:
    try:
        re.compile(value)
    except re.error as e:
        return False, f"Invalid regex: {e}"
    return True, ""


def v_iso_datetime(value: str) -> tuple[bool, str]:
    if not value:
        return False, "Start time is required."
    try:
        # Accept full ISO-8601 with offset or Z.
        datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return False, "Not ISO-8601 (e.g. 2025-05-18T13:00:00Z or 2025-05-18T13:00:00+02:00)."
    return True, ""


def v_positive_int(value: str) -> tuple[bool, str]:
    if not value.isdigit() or int(value) <= 0:
        return False, "Must be a positive integer."
    return True, ""


def v_ssh_dest(value: str) -> tuple[bool, str]:
    if not value:
        return True, ""  # optional
    if not re.match(r"^[^@\s]+@[^:\s]+:.+$", value):
        return False, "Expected user@host:/absolute/path"
    return True, ""


# ---------------------------------------------------------------------------
# .env parsing + rendering
# ---------------------------------------------------------------------------

_ENV_LINE_RE = re.compile(r"^(?P<key>[A-Z_][A-Z0-9_]*)=(?P<value>.*)$")


def parse_env_file(path: Path) -> dict[str, str]:
    """Return VAR/value pairs from an .env-style file, stripping quotes."""
    out: dict[str, str] = {}
    if not path.is_file():
        return out
    for line in path.read_text().splitlines():
        m = _ENV_LINE_RE.match(line)
        if not m:
            continue
        val = m["value"].strip()
        if len(val) >= 2 and val[0] == val[-1] and val[0] in ("\"", "'"):
            val = val[1:-1]
        out[m["key"]] = val
    return out


def _quote_if_needed(v: str) -> str:
    if v == "":
        return ""
    if re.search(r"[\s#\"'$`\\]", v):
        escaped = v.replace("\\", "\\\\").replace("\"", "\\\"")
        return f"\"{escaped}\""
    return v


def render_env(template: str, values: dict[str, str], extra_existing: dict[str, str]) -> str:
    """Render an .env by substituting known keys into the .env.example template.

    Keys in `values` are written; keys already in `extra_existing` but not in
    `values` and not in the template are appended at the end so pre-existing
    custom knobs survive.
    """
    seen_keys: set[str] = set()
    out_lines: list[str] = []
    for line in template.splitlines():
        m = _ENV_LINE_RE.match(line)
        if m:
            key = m["key"]
            seen_keys.add(key)
            if key in values:
                out_lines.append(f"{key}={_quote_if_needed(values[key])}")
            else:
                out_lines.append(line)
        else:
            out_lines.append(line)

    # Preserve unknown pre-existing keys that aren't in the template.
    leftovers = {k: v for k, v in extra_existing.items() if k not in seen_keys}
    if leftovers:
        out_lines.append("")
        out_lines.append("# --- Preserved from your previous .env ---------------------------------")
        for k, v in leftovers.items():
            out_lines.append(f"{k}={_quote_if_needed(v)}")

    return "\n".join(out_lines) + "\n"


