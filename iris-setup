def cmd_init_analysis(repo_root: Path, env_path: Path) -> int:
    """Render a complete split-pull-mode .env, generate keypair, prep dirs.

    Replaces the old "print sysadmin steps" version. Asks four short
    questions (gamenet IP, admin password, retention horizons), then writes
    a working .env, creates the traffic dir tree, copies seed files into
    place, and generates the bootstrap keypair if missing. Idempotent --
    backs up any existing .env to .env.bak.
    """
    import secrets, subprocess
    from datetime import datetime, timezone

    section("Analysis-box init (split-pull mode)")

    existing = parse_env_file(env_path) if env_path.is_file() else {}

    # 1. Gamenet IP - the address vulnboxes will reach for /admin/bootstrap.
    detected = _detect_gamenet_ip()
    default_api_host = (
        existing.get("IRIS_BOOTSTRAP_API_BASE", "").replace("http://", "").split(":")[0]
        or detected
        or "<your-wg-ip>"
    )
    api_host = ask(
        "Gamenet/WireGuard IP for this analysis box "
        "(vulnboxes reach this on :5000):",
        default=default_api_host,
        validator=v_ip if default_api_host != "<your-wg-ip>" else None,
        required=True,
    )

    # 2. Admin password - read masked, default to a random one if blank.
    print()
    print(dim("  Admin password for /admin/* endpoints. Empty = generate a random one."))
    import getpass
    while True:
        admin_pass = getpass.getpass("  Admin password: ").strip()
        if not admin_pass:
            admin_pass = "iris-" + secrets.token_urlsafe(18)
            info(f"Generated: {admin_pass}")
            break
        confirm = getpass.getpass("  Confirm: ").strip()
        if confirm == admin_pass:
            break
        err("Mismatch, try again.")

    # 3. Retention horizons - one round of questions with sane defaults.
    pcap_hours = ask(
        "Pcap retention (hours; 0 = keep forever):",
        default=existing.get("IRIS_PCAP_RETENTION_HOURS") or "24",
        validator=v_positive_int,
    )
    pcap_gb = ask(
        "Pcap size cap (GB; 0 = no cap):",
        default=existing.get("IRIS_PCAP_MAX_GB") or "50",
        validator=v_positive_int,
    )
    db_hours = ask(
        "DB retention (hours; 0 = keep forever):",
        default=existing.get("IRIS_DB_RETENTION_HOURS") or "48",
        validator=v_positive_int,
    )

    # 4. Where pcaps land. Default to ~/iris-traffic so it doesn't need root.
    default_traffic_dir = existing.get("TRAFFIC_DIR_HOST") \
        or str(Path.home() / "iris-traffic")
    traffic_dir = ask(
        "Path on this host to store pulled eve+pcaps:",
        default=default_traffic_dir,
        required=True,
    )

    # 5. Generate keypair if missing.
    priv, pub = _ensure_split_keypair(repo_root)

    # 6. Create + seed the traffic dir tree.
    tdir = Path(traffic_dir).expanduser()
    for sub in ("etc", "lib/rules", "log"):
        (tdir / sub).mkdir(parents=True, exist_ok=True)
    seed_yaml = repo_root / "suricata" / "etc" / "suricata.yaml"
    seed_rules = repo_root / "suricata" / "rules" / "local.rules"
    if seed_yaml.is_file() and not (tdir / "etc" / "suricata.yaml").exists():
        shutil.copy2(seed_yaml, tdir / "etc" / "suricata.yaml")
    if seed_rules.is_file() and not (tdir / "lib" / "rules" / "local.rules").exists():
        shutil.copy2(seed_rules, tdir / "lib" / "rules" / "local.rules")

    # 7. Render .env. Back up any existing one.
    body = _ANALYSIS_ENV_TEMPLATE.format(
        traffic_dir=str(tdir),
        api_host=api_host,
        admin_pass=admin_pass,
        pcap_hours=pcap_hours if pcap_hours != "0" else "",
        pcap_gb=pcap_gb if pcap_gb != "0" else "",
        db_hours=db_hours if db_hours != "0" else "",
        team_id=existing.get("TEAM_ID", "0"),
        vm_ip=existing.get("VM_IP", "0.0.0.0"),
        tick_start=existing.get("TICK_START") or
                   datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z"),
    )
    if env_path.is_file():
        backup = env_path.with_suffix(env_path.suffix + ".bak")
        shutil.copy2(env_path, backup)
        info(f"Backed up existing .env -> {backup}")
    env_path.write_text(body)
    info(f"Wrote {env_path}")
    info(f"Wrote {tdir}/{{etc,lib/rules,log}}")

    # 8. Next-step hint.
    print()
    print(green("Analysis box configured. Bring it up:"))
    print(f"  cd {repo_root} && docker compose up -d --build")
    print()
    print(green("Then enroll each vulnbox (one command per VM, password prompted once):"))
    print(f"  ./iris-setup --enroll-vulnbox <ip>")
    print()
    print(green("Once vulnboxes are running, populate services:"))
    print(f"  ./iris-setup --discover-services")
    return 0


def _ssh_with_password(host: str, user: str, password: str, command: str,
                       timeout: int = 300,
                       input_data: bytes | None = None) -> "subprocess.CompletedProcess":
    """Run a remote command over SSH, supplying the password via SSH_ASKPASS.

    Uses the standard setsid + SSH_ASKPASS trick so we never hand the
    password to a tty. The askpass shim lives in a 0700 tempdir and is
    deleted on return regardless of outcome.

    If `input_data` is given, it is streamed to the remote stdin (so e.g.
    `command="bash -s"` runs a script we already have on this host - no
    vulnbox -> analysis-box reachability required).
    """
    import subprocess, tempfile, shlex
    tmp = Path(tempfile.mkdtemp(prefix="iris-askpass-"))
    askpass = tmp / "askpass.sh"
    try:
        askpass.write_text(f"#!/bin/sh\nprintf '%s' {shlex.quote(password)}\n")
        askpass.chmod(0o700)
        env = os.environ.copy()
        env["SSH_ASKPASS"] = str(askpass)
        env["SSH_ASKPASS_REQUIRE"] = "force"
        env.setdefault("DISPLAY", ":0")
        # When piping stdin we can't use setsid -w, since setsid disconnects
        # the controlling terminal AND the stdin we're trying to write to.
        # Instead pass `-T` (no pty) so ssh forwards stdin to the remote.
        if input_data is not None:
            argv = [
                "ssh", "-T",
                "-o", "StrictHostKeyChecking=accept-new",
                "-o", "ConnectTimeout=10",
                "-o", "NumberOfPasswordPrompts=1",
                "-o", "PreferredAuthentications=password,keyboard-interactive,publickey",
                f"{user}@{host}",
                command,
            ]
        else:
            argv = [
                "setsid", "-w", "ssh",
                "-o", "StrictHostKeyChecking=accept-new",
                "-o", "ConnectTimeout=10",
                "-o", "NumberOfPasswordPrompts=1",
                f"{user}@{host}",
                command,
            ]
        return subprocess.run(
            argv,
            env=env,
            input=input_data,
            capture_output=True,
            timeout=timeout,
        )
    finally:
        try:
            askpass.unlink()
        except FileNotFoundError:
            pass
        try:
            tmp.rmdir()
        except OSError:
            pass


def _ssh_with_key(host: str, user: str, key: Path, command: str,
                  timeout: int = 60) -> "subprocess.CompletedProcess":
    import subprocess
    return subprocess.run(
        [
            "ssh", "-i", str(key),
            "-o", "BatchMode=yes",
            "-o", "StrictHostKeyChecking=accept-new",
            "-o", "ConnectTimeout=10",
            f"{user}@{host}",
            command,
        ],
        capture_output=True, text=True, timeout=timeout,
    )


def _append_vulnbox(env_path: Path, host: str, ip: str) -> None:
    """Add `host=ip` to VULNBOX_LIST. Deduped by IP so a re-enroll with
    a corrected hostname replaces a previous (failed) tag for the same
    IP rather than producing two entries the fetcher pulls in parallel."""
    text = env_path.read_text() if env_path.is_file() else ""
    pat = re.compile(r"^VULNBOX_LIST=(.*)$", re.MULTILINE)
    m = pat.search(text)
    current = m.group(1).strip() if m else ""
    entries: list[str] = [e for e in (x.strip() for x in current.split(",")) if e]
    # Drop any prior entry for this ip, then append the fresh one.
    kept: list[str] = []
    for e in entries:
        if "=" not in e:
            continue
        if e.split("=", 1)[1] == ip:
            continue
        kept.append(e)
    kept.append(f"{host}={ip}")
    new_value = ",".join(kept)
    if m:
        text = pat.sub(f"VULNBOX_LIST={new_value}", text, count=1)
    else:
        text += f"\nVULNBOX_LIST={new_value}\n"
    env_path.write_text(text)


def cmd_enroll_vulnbox(repo_root: Path, env_path: Path, ip: str) -> int:
    """SSH-with-password into a vulnbox, run the bootstrap curl, register it.

    Steps:
      1. Read API URL + admin creds from .env on this host.
      2. Get the vulnbox root password (env IRIS_VULNBOX_PASSWORD or prompt).
      3. SSH as root using setsid+SSH_ASKPASS.
      4. Run the bootstrap one-liner remotely.
      5. Read back the hostname (now via key auth - bootstrap installed our
         pubkey).
      6. Append host=ip to VULNBOX_LIST in .env.
      7. Restart the fetcher so it picks up the new entry.
    """
    import subprocess, getpass

    section(f"Enroll vulnbox {ip}")

    if not env_path.is_file():
        err("No .env on this host. Run iris-setup --init-analysis first.")
        return 2
    env = parse_env_file(env_path)
    api_base = env.get("IRIS_BOOTSTRAP_API_BASE", "")
    admin_user = env.get("IRIS_ADMIN_USER", "admin")
    admin_pass = env.get("IRIS_ADMIN_PASS", "")
    if not (api_base and admin_pass):
        err("Set IRIS_BOOTSTRAP_API_BASE and IRIS_ADMIN_PASS in .env first.")
        return 2

    keys_dir = _split_keys_dir(repo_root)
    priv = keys_dir / "id_ed25519"
    if not priv.is_file():
        err(f"No bootstrap keypair at {keys_dir}. Run --init-analysis first.")
        return 2

    user = env.get("VULNBOX_SSH_USER", "root")
    password = os.environ.get("IRIS_VULNBOX_PASSWORD", "").strip()
    if not password:
        try:
            password = getpass.getpass(f"  {user}@{ip} password: ")
        except (KeyboardInterrupt, EOFError):
            print()
            warn("Aborted.")
            return 130
    if not password:
        err("Empty password.")
        return 2

    # 3. Fetch /admin/bootstrap LOCALLY (analysis box -> its own api) and
    #    stream it over SSH stdin to the vulnbox. Most CTF gamenets are
    #    one-way (player -> vulnbox only), so the older "vulnbox curls
    #    back" design failed silently when the vulnbox couldn't reach us.
    import urllib.request, urllib.error, base64, ssl
    auth = base64.b64encode(f"{admin_user}:{admin_pass}".encode()).decode()
    # api_base might be the gamenet IP that vulnboxes use; locally we
    # can always reach 127.0.0.1:5000 since the api container publishes
    # there via docker compose.
    local_url = "http://127.0.0.1:5000/admin/bootstrap"
    req = urllib.request.Request(
        local_url, headers={"Authorization": f"Basic {auth}"}
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            script_bytes = resp.read()
    except urllib.error.HTTPError as e:
        err(f"GET {local_url} returned {e.code}: is the api up + admin password right?")
        return 2
    except urllib.error.URLError as e:
        err(f"GET {local_url} failed: {e.reason}. Is `docker compose up -d` done?")
        return 2

    # Add `set -o pipefail` so the outer ssh exit reflects the script's
    # actual outcome (the rendered script already starts with set -euo
    # pipefail; this is just belt-and-suspenders).
    info(f"Streaming bootstrap to {user}@{ip} (~3 min for first-time image build) ...")
    try:
        proc = _ssh_with_password(
            ip, user, password, "bash -s",
            input_data=script_bytes,
            timeout=900,
        )
    except FileNotFoundError as e:
        err(f"missing tool: {e} (need ssh + setsid)")
        return 2
    except subprocess.TimeoutExpired:
        err("bootstrap timed out (15 min). Check the vulnbox manually.")
        return 2

    out = proc.stdout.decode("utf-8", errors="replace")
    errout = proc.stderr.decode("utf-8", errors="replace")
    if proc.returncode != 0:
        err(f"bootstrap exited {proc.returncode}")
        if errout.strip():
            print(dim(errout.strip()[-1500:]))
        if out.strip():
            print(dim(out.strip()[-1500:]))
        return 2

    print(dim(out.strip()[-1500:]))

    # 4. Read hostname via key auth (bootstrap dropped our pubkey).
    try:
        host_proc = _ssh_with_key(ip, user, priv, "hostname", timeout=15)
    except FileNotFoundError as e:
        err(f"missing tool: {e}")
        return 2
    if host_proc.returncode != 0:
        warn("Couldn't ssh-key into the vulnbox after bootstrap. Falling back to ip as hostname.")
        host_tag = ip.replace(".", "_")
    else:
        host_tag = host_proc.stdout.strip().replace(".", "_") or ip.replace(".", "_")
    info(f"hostname tag: {host_tag}")

    # 5. Append to VULNBOX_LIST and restart fetcher.
    _append_vulnbox(env_path, host_tag, ip)
    info(f"Added {host_tag}={ip} to VULNBOX_LIST")

    # 6. Best-effort fetcher restart. If compose isn't up yet, this is fine.
    cp = subprocess.run(
        ["docker", "compose", "--profile", "fetcher", "up", "-d", "--no-deps", "fetcher"],
        cwd=repo_root, capture_output=True, text=True,
    )
    if cp.returncode == 0:
        info("Fetcher reloaded with new VULNBOX_LIST.")
    else:
        warn("docker compose ... fetcher failed. Bring it up manually:")
        print(dim(f"  cd {repo_root} && docker compose --profile fetcher up -d --no-deps fetcher"))

    print()
    print(green(f"Enrolled {host_tag} ({ip}). The fetcher will start pulling within ~30s."))
    print(dim("Set IRIS_VULNBOX_PASSWORD=... in your shell before enrolling more"))
    print(dim("vulnboxes with the same root password to skip the prompt."))
    return 0


def _discover_services_on(host: str, ip: str, ssh_key: Path) -> list[Service]:
    """Return one Service per published-port container we can find."""
    import subprocess
    # Emit one line per published-port container: name|container-ip|internal-port
    probe = (
        'for c in $(docker ps --format "{{.Names}}"); do '
        '  pub=$(docker port "$c" 2>/dev/null | head -1); '
        '  [ -z "$pub" ] && continue; '
        '  ip=$(docker inspect "$c" --format "{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}"); '
        '  port=$(docker inspect "$c" --format "{{range \\$p,\\$_ := .NetworkSettings.Ports}}{{\\$p}} {{end}}" | head -c 32 | head -1); '
        '  pnum=$(echo "$port" | head -1 | cut -d/ -f1); '
        '  echo "$c|$ip|$pnum"; '
        'done'
    )
    try:
        proc = _ssh_with_key(ip, "root", ssh_key, probe, timeout=20)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return []
    if proc.returncode != 0:
        warn(f"  ssh to {host} failed: {proc.stderr.strip()[:200]}")
        return []

    rows: list[tuple[str, str, str, int]] = []  # (project, base, ip, port)
    for line in proc.stdout.strip().splitlines():
        parts = line.split("|")
        if len(parts) != 3:
            continue
        cname, cip, cport = (p.strip() for p in parts)
        if not cip or not cport or not cport.isdigit():
            continue
        # Filter the obvious non-game backing services. The CTF service is
        # almost always the http frontend / cli / server container; the
        # backing DB / cache / processor doesn't get a name in iris.
        lower = cname.lower()
        if any(k in lower for k in (
            "mariadb", "mysql", "postgres", "redis", "memcache",
            "rabbit", "etcd", "elastic", "minio", "clickhouse",
            "backend", "processor", "worker"
        )):
            continue
        # Strip the trailing replica index (-N) docker compose adds.
        m = re.match(r"^(.*)-(\d+)$", cname)
        base = m.group(1) if m else cname
        project = base.split("-", 1)[0]
        rows.append((project, base, cip, int(cport)))

    # If a project has multiple service-named containers, qualify the name;
    # otherwise just use the project name. Operator can rename in the
    # diff-confirm step anyway.
    project_count: dict[str, int] = {}
    for p, *_ in rows:
        project_count[p] = project_count.get(p, 0) + 1

    out: list[Service] = []
    for project, base, cip, cport in rows:
        if project_count[project] == 1:
            name = project[:1].upper() + project[1:]
        else:
            tail = base[len(project) + 1:] or base  # drop "<project>-"
            name = f"{project[:1].upper()}{project[1:]}-{tail}"
        out.append(Service(ip=cip, port=cport, name=name))
    return out


def cmd_discover_services(repo_root: Path, env_path: Path, configs_path: Path) -> int:
    """SSH every entry in VULNBOX_LIST, build a services list, replace the
    block in configurations.py."""
    import subprocess

    section("Discover services from VULNBOX_LIST")
    if not env_path.is_file():
        err("No .env on this host. Run iris-setup --init-analysis first.")
        return 2
    env = parse_env_file(env_path)
    list_str = env.get("VULNBOX_LIST", "").strip()
    if not list_str:
        err("VULNBOX_LIST is empty. Enroll a vulnbox first (--enroll-vulnbox).")
        return 2

    keys_dir = _split_keys_dir(repo_root)
    priv = keys_dir / "id_ed25519"
    if not priv.is_file():
        err(f"No bootstrap key at {priv}. Run --init-analysis first.")
        return 2

    discovered: list[Service] = []
    for entry in list_str.split(","):
        entry = entry.strip()
        if "=" not in entry:
            continue
        host, ip = (x.strip() for x in entry.split("=", 1))
        info(f"Probing {host} ({ip}) ...")
        for s in _discover_services_on(host, ip, priv):
            print(f"  found: {s.name:<24}  {s.ip}:{s.port}")
            discovered.append(s)

    if not discovered:
        warn("No services discovered. Are the vulnboxes' game containers up?")
        return 0

    # Show what would be written
    print()
    print(bold("Proposed services entries:"))
    for s in discovered:
        print(f'    {{"ip": {s.ip!r}, "port": {s.port}, "name": {s.name!r}}},')
    print()

    if not ask_bool("Replace `services = [...]` in configurations.py with these?", default=True):
        warn("Skipped writing configurations.py.")
        return 0

    text = configs_path.read_text() if configs_path.is_file() else ""
    new_block_lines = ["services = ["]
    for s in discovered:
        new_block_lines.append(f'    {{"ip": {s.ip!r}, "port": {s.port}, "name": {s.name!r}}},')
    new_block_lines.append("]")
    new_block = "\n".join(new_block_lines) + "\n"

    pat = re.compile(r"^services\s*=\s*\[.*?\n\]\n", re.DOTALL | re.MULTILINE)
    if pat.search(text):
        new_text = pat.sub(new_block, text, count=1)
    else:
        # No prior services block (fresh install): use the full template.
        first_ip = list_str.split(",")[0].split("=", 1)[1] if "=" in list_str.split(",")[0] else "10.10.3.1"
        new_text = render_configurations_py(discovered, first_ip)

    if configs_path.is_file():
        backup = configs_path.with_suffix(configs_path.suffix + ".bak")
        shutil.copy2(configs_path, backup)
        info(f"Backed up -> {backup}")
    configs_path.write_text(new_text)
    info(f"Wrote {configs_path}")

    # `--build` is required: configurations.py is baked into the api image
    # via `COPY . /app` in services/api/Dockerfile-api, so a plain
    # `--force-recreate` would just restart the container with the stale
    # image and the UI would keep serving the previous services list.
    info("Rebuilding api image with the new services list (~30s) ...")
    cp = subprocess.run(
        ["docker", "compose", "--profile", "iris", "up", "-d", "--no-deps",
         "--build", "--force-recreate", "api", "frontend"],
        cwd=repo_root, capture_output=True, text=True,
    )
    if cp.returncode == 0:
        info("api + frontend rebuilt + recreated.")
    else:
        warn("Couldn't rebuild containers. Run manually:")
        print(dim(f"  cd {repo_root} && docker compose up -d --no-deps --build --force-recreate api frontend"))
        if cp.stderr.strip():
            print(dim(cp.stderr.strip()[-400:]))
    return 0


def cmd_add_vulnbox(repo_root: Path, env_path: Path) -> int:
    """Re-print the curl one-liner for adding (yet another) vulnbox.

    Pure presentation - no state changes. Useful mid-game when ICC drops a
    fresh VM and you've forgotten the URL or password.
    """
    section("Add a vulnbox")
    if not env_path.is_file():
        err("No .env on this host. Run iris-setup first.")
        return 2
    env = parse_env_file(env_path)
    api_base = env.get("IRIS_BOOTSTRAP_API_BASE", "")
    admin_user = env.get("IRIS_ADMIN_USER", "admin")
    admin_pass = env.get("IRIS_ADMIN_PASS", "")
    if not (api_base and admin_pass):
        err("Set IRIS_BOOTSTRAP_API_BASE and IRIS_ADMIN_PASS in .env first.")
        return 2

    keys_dir = _split_keys_dir(repo_root)
    if not (keys_dir / "id_ed25519").exists():
        err(f"No bootstrap keypair at {keys_dir}. Run iris-setup --init-analysis first.")
        return 2

    print()
    print(bold("On the new vulnbox (as a user with sudo + docker installed):"))
    print()
    print(f"  curl -fsSL -u {admin_user}:{admin_pass} \\")
    print(f"    {api_base}/api/admin/bootstrap | sudo bash")
    print()
    print(dim("Within ~30s the new VM should appear in eve-<hostname>.json on this host"))
    print(dim("and start pulling local.rules from the Settings page."))
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="iris-setup",
        description=(
            "Iris setup wizard - interactively generate .env and "
            "services/api/configurations.py."
        ),
        epilog=(
            "Screens: deployment mode -> traffic source -> game parameters -> "
            "services -> Suricata -> NFQUEUE (IPS only) -> shipper (vulnbox "
            "only) -> flag validator -> flagID scraping -> preview & write. "
            "Re-runnable: the current config is parsed and offered as the "
            "default at every prompt. Backups of overwritten files land next "
            "to the originals with a .bak suffix."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="Walk the prompts and render the new files, but do not write them.",
    )
    parser.add_argument(
        "--no-color", action="store_true",
        help="Disable ANSI colour output. Useful for piping into `less` or CI logs.",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--init-analysis", action="store_true",
        help=(
            "Split-pull-mode setup: ask for gamenet IP / admin password / "
            "retention horizons, render a complete .env, generate the "
            "bootstrap keypair, and seed the traffic dir tree. Skips the "
            "interactive wizard."
        ),
    )
    mode.add_argument(
        "--enroll-vulnbox", metavar="IP",
        help=(
            "SSH into a new vulnbox using its root password (prompted, or "
            "from $IRIS_VULNBOX_PASSWORD), pipe the bootstrap curl, and "
            "register the host in VULNBOX_LIST. Restarts the fetcher."
        ),
    )
    mode.add_argument(
        "--discover-services", action="store_true",
        help=(
            "SSH each entry in VULNBOX_LIST, docker-inspect to find the "
            "container IP/port for each game service, and replace the "
            "services list in services/api/configurations.py."
        ),
    )
    mode.add_argument(
        "--add-vulnbox", action="store_true",
        help=(
            "Re-print the curl one-liner for enrolling a new vulnbox using "
            "values already in .env (no SSH). Skips the interactive wizard."
        ),
    )
    args = parser.parse_args(argv)

    if args.no_color:
        global _USE_COLOR
        _USE_COLOR = False

    repo_root = Path(__file__).resolve().parent
    env_path = repo_root / ".env"
    env_example_path = repo_root / ".env.example"
    configs_path = repo_root / "services" / "api" / "configurations.py"

    if args.init_analysis:
        return cmd_init_analysis(repo_root, env_path)
    if args.enroll_vulnbox:
        return cmd_enroll_vulnbox(repo_root, env_path, args.enroll_vulnbox)
    if args.discover_services:
        return cmd_discover_services(repo_root, env_path, configs_path)
    if args.add_vulnbox:
        return cmd_add_vulnbox(repo_root, env_path)

    if not env_example_path.is_file():
        err(f"Can't find {env_example_path}. Run this wizard from the Iris repo root.")
        return 2

    state = WizardState()
    state.env = parse_env_file(env_path)
    existing_services, existing_vm_ip_1 = _parse_existing_services(configs_path)

    try:
        screen_welcome(state, state.env.copy())
        screen_mode(state)
        screen_traffic(state)
        screen_game(state)
        screen_services(state, existing_services, existing_vm_ip_1)
        screen_suricata(state)
        screen_nfqueue(state)
        screen_shipper(state)
        screen_validator(state)
        screen_flagids(state)
        return screen_preview_and_write(state, env_path, env_example_path,
                                        configs_path, args.dry_run)
    except (KeyboardInterrupt, EOFError):
        print()
        warn("Aborted.")
        return 130


if __name__ == "__main__":
    sys.exit(main())
