##############################
# Iris config
##############################

# Timescale connection
TIMESCALE="postgres://iris@timescale:5432/iris"

# The location of your pcaps as seen by the host
TRAFFIC_DIR_HOST="./services/test_pcap"

# The location of your pcaps (and eve.json), as seen by the container
TRAFFIC_DIR_DOCKER="/traffic"

# Set BPF filter expression (see https://www.tcpdump.org/manpages/pcap-filter.7.html)
#BPF="port 8080"

# Visualizer
#VISUALIZER_URL="http://scraper.example.com"

##############################
# Compose profiles
##############################
#
# Profiles control which stack of services is brought up. See docker-compose.yml.
#   iris            - DB, API, frontend, assembler, enricher, flagids
#   suricata-ids    - Suricata reading offline pcaps (legacy default)
#   suricata-ips    - Suricata inline via NFQUEUE (blocks matched attacks)
#   vulnbox-agent   - rsync shipper (split-mode, runs on the vulnbox)
#
# Typical recipes:
#   all-in-one IDS (today's default) : COMPOSE_PROFILES=iris,suricata-ids
#   all-in-one IPS                   : COMPOSE_PROFILES=iris,suricata-ips
#   split: on iris box              : COMPOSE_PROFILES=iris
#   split: on vulnbox                : COMPOSE_PROFILES=suricata-ips,vulnbox-agent
COMPOSE_PROFILES=iris,suricata-ids

##############################
# Game config
##############################

# Start time of the CTF (or network open if you prefer)
TICK_START="2024-11-30T13:00:00Z"

# Tick length in ms
TICK_LENGTH=180000

# The flag format in regex
FLAG_REGEX="[A-Z0-9]{31}="

# VM IP (inside gamenet)
# Currently ignored unless FLAGID_SCRAPE is set
VM_IP="10.10.3.1"
TEAM_ID="3"

##############################
# PCAP_OVER_IP CONFIGS
##############################

# Enable pcap-over-ip and choose server endpoint
# Empty value = disabled
PCAP_OVER_IP=
#PCAP_OVER_IP="host.docker.internal:1337"
# For multiple PCAP_OVER_IP you can comma separate
#PCAP_OVER_IP="host.docker.internal:1337,otherhost.com:5050"

##############################
# DUMP_PCAPS CONFIGS
##############################

# Enable pcap dumping and select target location
# Empty value = disabled
DUMP_PCAPS=
#DUMP_PCAPS="/traffic"

# Dumping options
# Ignored unless DUMP_PCAPS is set
DUMP_PCAPS_INTERVAL="1m"
DUMP_PCAPS_FILENAME="2006-01-02_15-04-05.pcap"

##############################
# FLAGID CONFIGS
##############################

# Enable flagid scrapping
# Empty value = disabled
FLAGID_SCRAPE=
#FLAGID_SCRAPE=1

# Enable flagid scanning - Tags flag ids in traffic
# Empty value = disabled
# Does nothing unless FLAGID_SCRAPE is set
FLAGID_SCAN=
#FLAGID_SCAN=1

# Flag lifetime in ticks
# Empty value = Fallback to TICK_LENGTH
# -1 = No check, pls don't use outside testing
FLAG_LIFETIME=
#FLAG_LIFETIME=-1
#FLAG_LIFETIME=5

# Flagid endpoint
# Default value is a test container in docker-compose-test.yml, change this for production
# Ignored unless FLAGID_SCRAPE is set
FLAGID_ENDPOINT="http://flagidendpoint:8000/flagids.json"

##############################
# FLAG_VALIDATOR CONFIGS
##############################

# Enables flag validation / fake flag feature. Must be one of: faust, enowars, eno, itad
# Empty value = disabled
FLAG_VALIDATOR_TYPE=

# Some flag validators can make use of (our) team number/ID
# Ignored unless FLAG_VALIDATOR_TYPE is set
FLAG_VALIDATOR_TEAM=42

##############################
# SETTINGS PAGE (Suricata rules editor)
##############################

# Credentials for the /admin/* API used by the Settings page. If
# IRIS_ADMIN_PASS is empty, the routes are unauthenticated - fine for
# a single-host dev setup, NOT fine on a network shared with other
# teams. Set both variables to enable HTTP basic auth.
IRIS_ADMIN_USER=admin
IRIS_ADMIN_PASS=

# Optional read-side HTTP basic auth on the WHOLE api. When both set,
# every /api/* request (and the UI that fetches them) requires basic
# auth - browser prompts once and caches per origin. /admin/* keeps
# its stricter admin gate, so admin and viewer creds can differ. Leave
# empty to keep the api open.
IRIS_AUTH_USER=
IRIS_AUTH_PASS=

##############################
# SPLIT-MODE BOOTSTRAP (analysis box only)
##############################

# Address vulnboxes can reach for /admin/bootstrap and /admin/rules.
# Typically the analysis box's WireGuard IP, e.g. http://10.0.0.1:5000.
# Leave empty in all-in-one mode.
IRIS_BOOTSTRAP_API_BASE=

# Where to find the analysis-box's bootstrap SSH private key. The wizard
# writes it here via `iris-setup --init-analysis`. Mounted RO into the
# api container (see IRIS_BOOTSTRAP_KEY_DIR for the host-side dir).
IRIS_BOOTSTRAP_KEY_PATH=/run/iris-keys/id_ed25519
IRIS_BOOTSTRAP_KEY_DIR=./iris-keys

# Bootstrap clones iris on the new vulnbox from this URL. Override if
# you maintain a fork.
IRIS_REPO_URL=https://github.com/caverav/iris.git
IRIS_REPO_REF=master

##############################
# SURICATA CONFIGS
##############################

# Directory for Suricata files (seeded on first run with rules from suricata/rules/
# and a minimal suricata.yaml from suricata/etc/). Subdirs: etc/, lib/, log/.
SURICATA_DIR_HOST="./suricata-runtime"

# If 1, run `suricata-update` at container start to pull ET-Open rules.
SURICATA_UPDATE_ENABLE=0

# Emit per-signature tags (sid:N) in addition to rule:<metadata-tag> tags.
# Disable (0) if a long CTF is pushing thousands of distinct sids into the
# tag table. Rule metadata tags are always emitted.
EMIT_SID_TAGS=1

##############################
# SURICATA IPS (NFQUEUE) - only used with the suricata-ips profile
##############################

# NFQUEUE number (matches the value Suricata is started with).
NFQUEUE_NUM=0

# Only queue traffic on this interface. Empty = all interfaces.
#NFQUEUE_IFACE=eth0
NFQUEUE_IFACE=

# iptables chains to hook. Defaults cover host-network and Docker bridge traffic.
# OUTPUT is included so Suricata's pcap-log captures server replies too,
# giving the assembler complete TCP conversations to reassemble.
NFQUEUE_CHAINS=INPUT,OUTPUT,FORWARD,DOCKER-USER

# Also install the jump on ip6tables.
NFQUEUE_IPV6=1

# Ports that bypass NFQUEUE entirely. RETURN rules ahead of the NFQUEUE jump
# mean these packets never reach Suricata, never get pcap-logged, and never
# end up in iris - AND keep flowing even if Suricata totally hangs (not
# just crashes). Defaults: SSH (22) so you can always log in, plus DNS (53),
# NTP (123), SSDP (1900), mDNS (5353) which are pure noise. Set empty to
# disable.
NFQUEUE_SKIP_PORTS=22,53,123,1900,5353

##############################
# JANITOR (disk + DB retention; opt-in via the `janitor` compose profile)
##############################

# Sweep cadence.
JANITOR_INTERVAL_SECONDS=3600

# Pcap pruning. Both off unless set. Whichever is stricter wins:
# IRIS_PCAP_RETENTION_HOURS deletes by age, IRIS_PCAP_MAX_GB by total size
# (oldest first). Recommended starting points: 8 hours OR 50 GB.
IRIS_PCAP_RETENTION_HOURS=
IRIS_PCAP_MAX_GB=

# TimescaleDB chunk retention on flow / flow_item / flow_index. Off unless
# set. Drops chunks (not rows) older than this; cheap. Recommended: 24 hours.
IRIS_DB_RETENTION_HOURS=

##############################
# VULNBOX-AGENT (split-mode shipper)
##############################

# rsync destination on the analysis box, e.g. user@iris:/srv/iris/traffic.
# Leave empty if you are not running in split mode.
VULNBOX_SSH_DEST=

# Path to an SSH key the shipper should use. The key must be authorized on
# the analysis box. Mounted read-only inside the shipper container.
#VULNBOX_SSH_KEY=./vulnbox-agent/id_ed25519

# Seconds between rsync pushes.
SHIP_INTERVAL=30
